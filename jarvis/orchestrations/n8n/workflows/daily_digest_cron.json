{
  "name": "Jarvis Daily Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hour",
              "mode": "everyWeekDay",
              "hour": 9,
              "minute": 0
            }
          ]
        }
      },
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "http://api:8000/plan/next",
        "method": "POST",
        "jsonParameters": true,
        "bodyParametersJson": "{\n  \"user_id\": 1\n}"
      },
      "name": "Plan Next",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2
    },
    {
      "parameters": {
        "chatId": "123456",
        "text": "={{'Daily digest:\n' + $json.actions.map(a => '- ' + a.title).join('\n')}}"
      },
      "name": "Telegram Digest",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "credentials": {
        "telegramApi": "Jarvis Telegram Bot"
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Plan Next",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan Next": {
      "main": [
        [
          {
            "node": "Telegram Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
